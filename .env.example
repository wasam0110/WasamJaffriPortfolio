# ════════════════════════════════════════════════════════════════
# .env.example — Environment variable template
#
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit .env to Git — it's listed in .gitignore.
# ════════════════════════════════════════════════════════════════

# ── Chat Widget ─────────────────────────────────────────────────
# Set to "true" to show the AI chat bubble on your portfolio.
# Requires a backend proxy to avoid exposing the API key.
# See vite.config.js for local dev proxy setup.
VITE_CHAT_ENABLED=false

# Your Anthropic API key — used by your BACKEND PROXY ONLY.
# Never put this in a client-side .env file that ships to browsers.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Site meta (used in OG tags if you server-render) ────────────
VITE_SITE_URL=https://wasamjaffri.dev
